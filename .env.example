# Azure deployment service principal credentials (Contributor access).
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure resource names (STORAGE_ACCOUNT must be globally unique).
STORAGE_ACCOUNT=
DATA_FACTORY=

# Copy the workspace URL from your Databricks Free Edition browser address.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# Create a workspace access token for the account that owns/runs the job.
DATABRICKS_TOKEN=
# Folder for all deployed notebooks and Python utility files.
DATABRICKS_NOTEBOOK_PATH=/Shared/analytics-demo
