# Deployment service principal (needs Owner on the subscription). Setup: AZURE.md.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure resource names (STORAGE_ACCOUNT must be globally unique).
STORAGE_ACCOUNT=
DATA_FACTORY=
RESOURCE_GROUP=rg-analytics-demo
AZURE_LOCATION=japaneast

# Existing Azure Databricks serverless workspace.
DATABRICKS_HOST=https://adb-<workspace-id>.<number>.azuredatabricks.net
# Create a workspace access token for the account that owns/runs the job.
DATABRICKS_TOKEN=
# Folder for all deployed notebooks and Python utility files.
DATABRICKS_NOTEBOOK_PATH=/Shared/analytics-demo
# Unity Catalog catalog; created by setup/deploy if it does not exist.
DATABRICKS_CATALOG=bnstprod
