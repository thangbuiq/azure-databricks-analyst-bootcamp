# Instructor setup: copy to .env. Students run notebooks in Databricks.
POLL_SECONDS=15
TIMEOUT_SECONDS=3600

# One service principal: set by your course administrator.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Object ID of the service principal (not the app/client ID).
AZURE_PRINCIPAL_OBJECT_ID=

AZURE_LOCATION=southeastasia
RESOURCE_GROUP=rg-analytics-demo
# Globally unique, lowercase letters/numbers, 3-24 characters.
STORAGE_ACCOUNT=
DATABRICKS_WORKSPACE=dbw-analytics-demo
DATA_FACTORY=adf-analytics-demo
# Optional account ID for automatic assignment of the ADF identity.
# Requires the configured principal to be a Databricks account admin.
DATABRICKS_ACCOUNT_ID=
DATABRICKS_RUNTIME=16.4.x-scala2.12
DATABRICKS_NODE_TYPE=Standard_D4ds_v5
DATABRICKS_NOTEBOOK_PATH=/Shared/analytics-demo/sales_demo
DATABRICKS_SECRET_SCOPE=analytics-demo
# Optional compute policy required by your organization.
DATABRICKS_POLICY_ID=
